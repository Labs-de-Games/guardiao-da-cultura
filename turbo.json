{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_POSTHOG_KEY",
        "NEXT_PUBLIC_POSTHOG_HOST",
        "NEXT_PUBLIC_ENV"
      ]
    },
    "lint": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": []
    },
    "test": {
      "dependsOn": ["build"]
    },
    "start:dev": {
      "persistent": true,
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": [
        "RESPONSIVEVOICE_API_KEY",
        "AUTH_SECRET",
        "AUTH_TRUST_HOST",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "AUTH_OAUTH_UPSERT_TOKEN",
        "BACKEND_INTERNAL_URL",
        "POSTHOG_PERSONAL_API_KEY",
        "POSTHOG_PROJECT_ID",
        "POSTHOG_QUERY_HOST",
        "POSTHOG_QUERY_CACHE_TTL_MS"
      ]
    }
  }
}

# Gameplate Environment Variables
# Copy this file to .env and adjust values for your environment.
# All defaults below are suitable for local development.

# Frontend (Next.js)
FRONTEND_PORT=3000

# Deployment environment (development | staging | production).
# Controls PostHog behavior: canvas recording, surveys, debug mode.
# NODE_ENV is always "production" for Next.js builds (bundling optimization).
NEXT_PUBLIC_ENV=development

# Public API URL exposed to the browser.
# For local dev, this points to the backend container.
# For staging/production, set to your public API domain.
FRONTEND_API_URL=http://localhost:3001

# ResponsiveVoice (Text-to-Speech) — server-side only, never NEXT_PUBLIC_
# Get your free key from https://www.responsivevoice.org/
RESPONSIVEVOICE_API_KEY=xxxxxxxx
# RESPONSIVEVOICE_API_URL=https://texttospeech.responsivevoice.org/v1/text:synthesize

# Backend (NestJS)
BACKEND_PORT=3001

# Logging level: trace | debug | info | warn | error | fatal
# Defaults to debug in development and info in production.
LOG_LEVEL=debug

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/template

# JWT secrets — rotate these for staging and production!
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=15m
JWT_ISSUER=gameplate

# Magic link secrets — rotate these for staging and production!
MAGIC_LINK_SECRET=change-me-in-production
MAGIC_LINK_EXPIRATION_MIN=15

# URL where the frontend is served. Used for CORS and email links.
# For local dev: http://localhost:3000
# For staging:   https://staging.your-domain.com
# For production: https://your-production-domain.com
FRONTEND_URL=http://localhost:3000

# Email Configuration
# Use "mock" for local dev (logs to console).
# Use "nodemailer" for staging/production with real email delivery.
EMAIL_PROVIDER=mock

# Required only when EMAIL_PROVIDER=nodemailer
GMAIL_USER=
GMAIL_APP_PASSWORD=

EMAIL_FROM=42 Rio <noreply@42.rio>

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=template
POSTGRES_PORT=5432

# Nginx
NGINX_PORT=80

# PostHog (same project for frontend and backend)
# Get your Project API Key from PostHog > Settings > Project > Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com

# PostHog personal key — used ONLY by the /institution edital dashboard's
# Next.js route handlers to call the Query API (HogQL). Never NEXT_PUBLIC_*.
# All four below are optional: the app boots unconfigured without them and
# /api/edital/health reports configured:false.
POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_PROJECT_ID=your-posthog-project-id-here
POSTHOG_QUERY_HOST=https://us.posthog.com
POSTHOG_QUERY_CACHE_TTL_MS=300000
# The reportable window's start (ISO date, e.g. 2026-04-01) — set once
# #740's actual deploy date is known. Leave unset until then; setting an
# arbitrary date here silently mis-scopes every all-time/custom query with
# no error, so do not guess.
EDITAL_PERIOD_START=

# NextAuth.js (institution dashboard accounts, epic #738, #744)
# AUTH_TRUST_HOST is required behind the nginx reverse proxy.
AUTH_SECRET=your-nextauth-secret-here
AUTH_TRUST_HOST=true
# Google OAuth app credentials — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-oauth-client-id-here
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret-here
# Shared secret between the front (auth.ts's signIn callback) and the
# backend's /auth/oauth/upsert endpoint, which creates institution-role
# users. Same value on both sides.
AUTH_OAUTH_UPSERT_TOKEN=your-auth-oauth-upsert-token-here

# Infrastructure
# Cloudflare Tunnel token — required only in production
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

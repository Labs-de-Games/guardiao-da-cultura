{
  "name": "back",
  "private": true,
  "scripts": {
    "start:dev": "npx nest start --watch",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "biome check .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/core/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/core/database/data-source.ts",
    "migration:run:prod": "npx typeorm -d dist/core/database/data-source.js migration:run",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/core/database/data-source.ts",
    "db:drop": "typeorm-ts-node-commonjs schema:drop -d src/core/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "latest",
    "@nestjs/core": "latest",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "latest",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "posthog-node": "^5.35.5",
    "reflect-metadata": "latest",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28",
    "zod": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@nestjs/cli": "latest",
    "@nestjs/testing": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "jest": "latest",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "latest"
  }
}

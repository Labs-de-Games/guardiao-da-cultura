{
  "name": "template-clone",
  "private": true,
  "workspaces": [
    "front",
    "back"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "husky": "latest",
    "lint-staged": "latest",
    "turbo": "latest"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json}": [
      "biome check --write"
    ]
  },
  "packageManager": "bun@1.3.11"
}
